# ================================
# GreenRoot Backend — Environment
# Copy this file to `.env` and fill in real values.
# ================================

# --- Server ---
APP_NAME=GreenRoot API
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB ---
# Defaults to a local MongoDB instance.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=greenroot_db

# --- JWT ---
# Use `python -c "import secrets; print(secrets.token_hex(32))"` to generate a strong secret.
SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- File uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Administrator accounts -----------------------------------------------
# app/seed.py bcrypt-hashes these on first boot and skips any username that
# already exists. Keep real values in `.env` (git-ignored), never in this file.
#
# Option A — a single admin:
# ADMIN_USERNAME=your-admin
# ADMIN_EMAIL=your-admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password
#
# Option B — several admins as a JSON array (used by this project):
# ADMIN_ACCOUNTS=[{"username":"darshit","email":"darshit@example.com","password":"...","full_name":"Darshit"}]
ADMIN_ACCOUNTS=
