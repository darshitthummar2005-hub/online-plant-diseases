# ============================================================
# Backend environment template (FastAPI)
# Copy to `.env` for local dev, or set these as Environment
# Variables on your hosting provider (Render / Railway / etc).
# NEVER commit a real `.env` - it is git-ignored.
# ============================================================

# --- Server ---
# Most hosts inject PORT automatically; bind 0.0.0.0 so it is reachable.
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Must include your deployed frontend URL or the browser blocks every request.
# Example: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- MongoDB ---
# LOCAL DEV ONLY: a local mongod. Never use this in production.
# PRODUCTION: use a MongoDB Atlas connection string, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=greenroot_db

# --- JWT ---
# REQUIRED IN PRODUCTION. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating this invalidates all issued tokens.
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- File uploads ---
# Images are written to this directory and served from /uploads.
# On hosts with an ephemeral filesystem this data is lost on redeploy -
# point it at a mounted persistent volume in production.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Bootstrap admin (optional) ---
# Created on first boot only, and only if username, email AND password are all
# set. Leave blank and use `python scripts/create_admin.py` instead if unsure.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Additional admins (optional) ---
# JSON array. Passwords stay in your env store / .env, never in source code.
# ADMIN_ACCOUNTS=[{"username":"admin2","email":"admin2@example.com","password":"a-strong-password"}]
ADMIN_ACCOUNTS=