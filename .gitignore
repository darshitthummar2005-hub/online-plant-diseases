# ---- Secrets: never commit these ----
# backend/.env holds the ADMIN_ACCOUNTS passwords and the JWT signing secret.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
secrets*.json

