# ============================================================
# Frontend environment template (Vite + React)
# Copy to `.env` for local dev, or set these as Environment
# Variables in Vercel (Settings -> Environment Variables).
# NEVER commit a real `.env` - it is git-ignored.
# ============================================================

# Base URL of the backend API, WITHOUT a trailing slash.
#
# LOCAL DEV:
#   Leave VITE_API_URL empty and `npm run dev` proxies /api to
#   http://127.0.0.1:8000 automatically (see vite.config.js).
#
# PRODUCTION (Vercel):
#   Set this to your deployed backend, for example
#   https://plant-disease-api.onrender.com/api
#   The deployed backend's CORS_ORIGINS must also list your Vercel URL.
VITE_API_URL=